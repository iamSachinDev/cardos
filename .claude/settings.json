{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(gitleaks git --redact -v --no-banner .)",
      "Bash(gitleaks dir --redact -v --no-banner .)",
      "Bash(gitleaks git --staged --redact -v --no-banner .)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh pr close *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh release *)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(npm run cardos *)",
      "Bash(node scripts/start-cardos.mjs *)",
      "Bash(brew services *)",
      "Bash(launchctl *)",
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm update *)",
      "Bash(npm uninstall *)",
      "Bash(patch *)",
      "Bash(git stash *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Edit(/patches/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.githooks/**)",
      "Edit(/.gitignore)",
      "Edit(/.github/**)",
      "Edit(/policy/**)",
      "Edit(/.opengrep/**)",
      "Edit(/.specify/memory/constitution.md)",
      "Edit(/src/lib/gmail.ts)",
      "Edit(/scripts/configure-gmail.mjs)",
      "Edit(/src/lib/api.ts)",
      "Edit(/src/lib/publicFees.ts)",
      "Edit(/src/lib/trends.ts)",
      "Edit(/src/components/BillsView.tsx)",
      "Edit(/src/components/Dashboard.tsx)",
      "Edit(/src/components/FeeOptimizerView.tsx)",
      "Edit(/src/components/CardDetail.tsx)",
      "Edit(/src/components/SixMonthTrend.tsx)",
      "Bash(npm run dev*)",
      "Bash(npm start*)",
      "Bash(npm run start*)",
      "Bash(npm run preview*)"
    ],
    "deny": [
      "Read(//opt/homebrew/var/burnrate/**)",
      "Read(//opt/homebrew/var/**/burnrate*)",
      "Read(//opt/homebrew/opt/burnrate/libexec/.env*)",
      "Read(//opt/homebrew/Cellar/burnrate/**/.env*)",
      "Read(//**/.env*)",
      "Read(//**/*.pdf)",
      "Read(//**/*.csv)",
      "Read(//**/*.tsv)",
      "Read(//**/*.xls*)",
      "Read(//**/*.ofx)",
      "Read(//**/*.qfx)",
      "Read(//**/*.db)",
      "Read(//**/*.db-wal)",
      "Read(//**/*.db-shm)",
      "Read(//**/*.db-journal)",
      "Read(//**/*.sqlite*)",
      "Read(//**/client_secret*.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)",
      "Bash(sqlite3 *)",
      "Bash(pdftotext *)",
      "Bash(npm run gmail:setup *)",
      "Bash(node scripts/configure-gmail.mjs *)",
      "Bash(curl *:8000*)",
      "Bash(wget *:8000*)",
      "Bash(curl */api/*)",
      "Bash(wget */api/*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *main*)",
      "Bash(git push *master*)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git add * -f *)",
      "Bash(git add * --force*)",
      "Bash(git add *-f)",
      "Bash(git add .)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(git commit * -a*)",
      "Bash(git commit *--amend*)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git update-ref *)",
      "Bash(git reset --hard *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(git branch -D *)",
      "mcp__claude_ai_*",
      "mcp__*__*send*",
      "mcp__*__*forward*",
      "mcp__*__*share*",
      "mcp__*__*upload*",
      "mcp__*__*reply*",
      "mcp__*__*publish*",
      "mcp__serena__execute_shell_command",
      "mcp__serena__create_text_file",
      "mcp__serena__replace_content",
      "mcp__serena__replace_in_files",
      "mcp__serena__replace_lines",
      "mcp__serena__delete_lines",
      "mcp__serena__insert_at_line",
      "mcp__serena__insert_before_symbol",
      "mcp__serena__insert_after_symbol",
      "mcp__serena__replace_symbol_body",
      "mcp__serena__rename_symbol",
      "mcp__serena__safe_delete_symbol",
      "mcp__serena__write_memory",
      "mcp__serena__edit_memory",
      "mcp__serena__rename_memory",
      "mcp__serena__delete_memory",
      "mcp__serena__onboarding",
      "mcp__serena__serena_repl",
      "mcp__serena__search_for_pattern",
      "mcp__serena__read_file",
      "mcp__serena__list_dir",
      "mcp__serena__find_file",
      "mcp__serena__read_memory",
      "mcp__serena__list_memories"
    ]
  },
  "enabledMcpjsonServers": [
    "serena"
  ],
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [
      "git push *",
      "git fetch *",
      "git pull *",
      "gh *",
      "npm run cardos *",
      "brew services *",
      "npm ci *",
      "npm install *",
      "npm i *",
      "npm update *",
      "npm uninstall *",
      "npm run ai:worktree *"
    ],
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "registry.npmjs.org"
      ]
    },
    "filesystem": {
      "denyWrite": [
        "./.githooks"
      ],
      "allowRead": [
        "//**/.env.example"
      ]
    }
  }
}
