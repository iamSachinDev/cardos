{
  "name": "cardos-burnrate-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Premium Astro frontend for the local Burnrate credit-card analytics backend.",
  "license": "MIT",
  "scripts": {
    "cardos": "node scripts/start-cardos.mjs",
    "gmail:setup": "node scripts/configure-gmail.mjs",
    "ai:worktree": "node scripts/ai-worktree.mjs",
    "ai:models": "node scripts/check-model-policy.mjs",
    "docs:links": "node scripts/check-docs.mjs links",
    "docs:impact": "node scripts/check-docs.mjs impact",
    "docs:routes": "node scripts/generate-route-doc.mjs",
    "docs:routes:check": "node scripts/generate-route-doc.mjs --check",
    "docs:test": "node --test scripts/check-docs.test.mjs",
    "test": "vitest run src/lib",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
