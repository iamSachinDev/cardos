+# Files that their creator (Gmail sync) submits to the processing queue itself.
+# The watcher skips them so each file is processed once, watcher running or not.
+_claimed_paths: Set[str] = set()
+_claimed_lock = threading.Lock()
 
+
+def _path_key(path) -> str:
+    # APFS is case-insensitive and the configured folder may differ in case or
+    # go through a symlink, so compare resolved, lower-cased paths.
+    return os.path.realpath(str(path)).lower()
+
+
+def claim_path(path) -> None:
+    """Mark *path* as queued by its creator; call before the file appears."""
+    with _claimed_lock:
+        _claimed_paths.add(_path_key(path))
+
+
+def release_path(path) -> None:
+    """Undo claim_path, e.g. when the file could not be written."""
+    with _claimed_lock:
+        _claimed_paths.discard(_path_key(path))
+
+
+def _is_claimed(path) -> bool:
+    with _claimed_lock:
+        return _path_key(path) in _claimed_paths
+
