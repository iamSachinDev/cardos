+++ backend/parsers/sc.py	2026-10-17 23:35:12
@@ -0,0 +1,75 @@
+"""Standard Chartered credit card statement parser.
+
+Statement layout (page 1):
+  - Header: "Statement Period : 08 Jan 2026 To 07 Feb 2026",
+    "Payment Due Date : 28 Feb 2026", "Total Payment Due (INR) : 1,234.56",
+    "Credit Limit (INR) : 100,000.00" (a credit balance ends in "CR")
+  - Card: "<BIN6>XXXXXX<last4>" above the transaction table
+  - Transactions: "DDMMYY <description> [<reference>] <rewards earned> <rewards type> <amount> [CR]"
+    e.g. "150126 SOME MERCHANT <23-digit ref> 0 001 250.00"; a wrapped
+    description (e.g. the city) continues on the next line and is ignored.
+"""
+
+import logging
+import re
+from datetime import date, datetime
+from typing import Optional, Tuple
+
+from backend.parsers.base import ParsedTransaction
+from backend.parsers.generic import GenericParser
+
+logger = logging.getLogger(__name__)
+
+_PERIOD_RE = re.compile(
+    r"Statement\s+Period\s*:\s*(\d{1,2}\s+[A-Za-z]{3}\s+\d{4})\s+To\s+(\d{1,2}\s+[A-Za-z]{3}\s+\d{4})",
+    re.IGNORECASE,
+)
+
+_TXN_RE = re.compile(
+    r"^(\d{6})\s+(.+?)\s+(\d+(?:\.\d+)?)\s+(\d{3})\s+([\d,]+\.\d{2})(?:\s+(CR))?$",
+    re.IGNORECASE,
+)
+
+# Transaction reference numbers printed between description and rewards columns.
+_REFERENCE_RE = re.compile(r"\s*\b\d{12,}\b")
+
+
+class StandardCharteredParser(GenericParser):
+    """Parser for Standard Chartered credit card statements."""
+
+    def __init__(self, bank: str = "sc"):
+        super().__init__(bank=bank)
+
+    def _extract_period(self, text: str) -> Tuple[Optional[date], Optional[date]]:
+        m = _PERIOD_RE.search(text)
+        if not m:
+            return super()._extract_period(text)
+        return _parse_long_date(m.group(1)), _parse_long_date(m.group(2))
+
+    def _parse_transaction_line(self, line: str) -> Optional[ParsedTransaction]:
+        m = _TXN_RE.match(line)
+        if not m:
+            return None
+        try:
+            parsed_date = datetime.strptime(m.group(1), "%d%m%y").date()
+            amount = float(m.group(5).replace(",", ""))
+        except ValueError:
+            return None
+        if amount <= 0:
+            return None
+
+        raw_desc = _REFERENCE_RE.sub("", m.group(2)).strip()
+        return ParsedTransaction(
+            date=parsed_date,
+            merchant=raw_desc[:512] if raw_desc else "Unknown",
+            amount=amount,
+            type="credit" if m.group(6) else "debit",
+            description=raw_desc,
+        )
+
+
+def _parse_long_date(value: str) -> Optional[date]:
+    try:
+        return datetime.strptime(value.strip(), "%d %b %Y").date()
+    except ValueError:
+        return None
